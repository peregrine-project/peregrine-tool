opam-version: "2.0"
name: "rocq-peregrine"
version: "dev"
synopsis: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
description: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
maintainer: "The Peregrine team"
authors: "The Peregrine team"
license: "MIT"
tags: ["keyword:extraction" "logpath:Peregrine"]
homepage: "https://peregrine-project.github.io/"
bug-reports: "https://github.com/peregrine-project/peregrine-tool/issues"
depends: [
  "rocq-core" {= "9.1.1"}
  "rocq-runtime" {= "9.1.1"}
  "rocq-stdlib" {= "9.0.0"}
  # The version the CertiRocq pin was validated with. Without it, a switch
  # restored from the cache of an older lock file keeps mathcomp 2.4.0.
  "rocq-mathcomp-ssreflect" {= "2.5.0"}
  "rocq-certirocq" {= "dev"}
  "rocq-vellvm" {= "dev"}
  "rocq-ceres-bytestring" {= "1.0.0"}
  "rocq-metarocq-erasure-plugin" {= "1.5.1+9.1+dev"}
  "rocq-primitive" {= "9.0.0"}
  "rocq-typed-extraction-common" {= "0.2.1"}
  "rocq-elm-extraction" {= "0.2.1"}
  "rocq-rust-extraction" {= "0.2.1"}
  "rocq-cakeml-extraction" {= "0.1.1+dev"}
  "rocq-verified-extraction" {= "1.0.0+9.1+dev"}
  "cmdliner" {= "2.1.0"}
]
pin-depends: [
  # The peregrine branch of peregrine-project/certirocq: CertiRocq main
  # (943b52ae) plus the LLVM backend, Peregrine's fixes and
  # the shadow-stack change of CertiRocq/certirocq#155.
  ["rocq-certirocq.dev" "git+https://github.com/peregrine-project/certirocq.git#c1c99e436d2cce95f8de5b87d10173ca56a30b48"]
  ["rocq-vellvm.dev" "git+https://github.com/vellvm/vellvm.git#b63a28a0a36cbae73a454d99a97bb8171568343e"]
  # The peregrine branch of peregrine-project/rocq-verified-extraction: a
  # merge of its rocq-9.1 branch (64ced8c0, the same tree), which builds
  # against MetaRocq 51b14e4b and has the rename of switch_no_params for
  # MetaRocq#1286 (MetaRocq/rocq-verified-extraction#44).
  ["rocq-verified-extraction.1.0.0+9.1+dev" "git+https://github.com/peregrine-project/rocq-verified-extraction.git#0ed8aa88560a518e0822b583f45e1ebb45b10f7f"]
  # cakeml-backend ported to the MetaRocq 9.1 snapshot, with the datatype
  # declarations and qualified constructor names (cakeml-backend#16).
  ["rocq-cakeml-extraction.0.1.1+dev" "git+https://github.com/peregrine-project/cakeml-backend.git#8df83a16525ca08bb9b5b375b3331b3f480d346b"]
  # rocq-typed-extraction v0.2.1 plus the qualified Import String that
  # MetaRocq 51b14e4b needs (branch metarocq-51b14e4b).
  ["rocq-typed-extraction-common.0.2.1" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#d04536f9cf4eb0fd2d499ce74c054e440fb43894"]
  ["rocq-rust-extraction.0.2.1" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#d04536f9cf4eb0fd2d499ce74c054e440fb43894"]
  ["rocq-elm-extraction.0.2.1" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#d04536f9cf4eb0fd2d499ce74c054e440fb43894"]
  ["rocq-metarocq-utils.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-common.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-template.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-template-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-safechecker.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-erasure.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-safechecker-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
  ["rocq-metarocq-erasure-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#51b14e4bb5f4580f00f60208ff8dbf31f3ad6f56"]
]
build: [make "build"]
install: [make "install"]
dev-repo: "git+https://github.com/peregrine-project/peregrine-tool.git"
