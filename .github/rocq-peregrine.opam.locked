opam-version: "2.0"
name: "rocq-peregrine"
version: "dev"
synopsis: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
description: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
maintainer: "The Peregrine team"
authors: "The Peregrine team"
license: "MIT"
tags: ["keyword:extraction" "logpath:Peregrine"]
homepage: "https://peregrine-project.github.io/"
bug-reports: "https://github.com/peregrine-project/peregrine-tool/issues"
depends: [
  "rocq-core" {= "9.1.1"}
  "rocq-runtime" {= "9.1.1"}
  "rocq-stdlib" {= "9.0.0"}
  "rocq-certirocq" {= "0.9.1+9.1+llvm"}
  "rocq-vellvm" {= "dev"}
  "rocq-ceres-bytestring" {= "1.0.0"}
  "rocq-metarocq-erasure-plugin" {= "1.5.1+9.1"}
  "rocq-primitive" {= "9.0.0"}
  "rocq-typed-extraction-common" {= "0.2.1"}
  "rocq-elm-extraction" {= "0.2.1"}
  "rocq-rust-extraction" {= "0.2.1"}
  "rocq-cakeml-extraction" {= "0.1.0"}
  "rocq-verified-extraction" {= "1.0.0+9.1"}
  "cmdliner" {= "2.1.0"}
]
pin-depends: [
  ["rocq-certirocq.0.9.1+9.1+llvm" "git+https://github.com/spitters/certirocq.git#13e3f16fcfa79bd0b8246640bf6b71d29ff1cba9"]
  ["rocq-vellvm.dev" "git+https://github.com/vellvm/vellvm.git#b63a28a0a36cbae73a454d99a97bb8171568343e"]
]
build: [make "build"]
install: [make "install"]
dev-repo: "git+https://github.com/peregrine-project/peregrine-tool.git"
