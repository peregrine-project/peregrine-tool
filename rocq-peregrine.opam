opam-version: "2.0"
name: "rocq-peregrine"
version: "dev"
synopsis: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
description: """
The Peregrine tool is a unified middle-end for code generation from proof assistants
"""
maintainer: "The Peregrine team"
authors: "The Peregrine team"
license: "MIT"
homepage: "https://peregrine-project.github.io/"
dev-repo: "git+https://github.com/peregrine-project/peregrine-tool.git"
bug-reports: "https://github.com/peregrine-project/peregrine-tool/issues"

depends: [
  "rocq-core" {>= "9.1" & < "9.2~"}
  "rocq-stdlib" {>= "9.0" & < "9.2~"}
  "rocq-metarocq-erasure-plugin" {>= "1.5.1" & < "1.5.2"}
  "rocq-typed-extraction-common" {= "0.2.1"}
  "rocq-rust-extraction" {= "0.2.1"}
  "rocq-elm-extraction" {= "0.2.1"}
  "rocq-cakeml-extraction" {= "0.1.0+dev"}
  "rocq-verified-extraction" {= "1.0.0+9.1+dev"}
  "rocq-primitive" {= "9.0.0"}
  "rocq-ceres-bytestring" {= "1.0.0"}
  "rocq-certirocq" {= "dev"}
  "rocq-vellvm" {= "dev"}
  "cmdliner" {>= "2.0.0"}
]

# CertiRocq with the LLVM backend (CertiRocq/certirocq#155) is in no
# release, and neither are the Vellvm commit it needs and the MetaRocq 9.1
# snapshot it is built against (MetaRocq 1.5.1 lacks EImplementLazyForce).
# The MetaRocq snapshot gets the version 1.5.1+9.1+dev, so that it satisfies
# the `< 1.5.2` bounds of rocq-verified-extraction and rocq-cakeml-extraction,
# whose releases do not build against it. Keep all commits equal to the ones
# in .github/rocq-peregrine.opam.locked and .nix/.
pin-depends: [
  # TODO(#155): replace by the commit of CertiRocq/certirocq main that merges #155:
  #   ["rocq-certirocq.dev" "git+https://github.com/CertiRocq/certirocq.git#<merge commit>"]
  ["rocq-certirocq.dev" "git+https://github.com/barabbs/certirocq.git#6b4ab87014ccdddf69ea4a9278c4974ba671ca2d"]
  ["rocq-vellvm.dev" "git+https://github.com/vellvm/vellvm.git#b63a28a0a36cbae73a454d99a97bb8171568343e"]
  # TODO: MetaRocq 9.1 snapshot ports, not yet pushed: rocq-verified-extraction
  # main plus a one-line rename for MetaRocq#1286, and cakeml-backend v0.1.0
  # adapted like rocq-verified-extraction bb535da.
  ["rocq-verified-extraction.1.0.0+9.1+dev" "git+https://github.com/MetaRocq/rocq-verified-extraction.git#16de6e9f67b1085ef519095433f96f8b1067febe"]
  ["rocq-cakeml-extraction.0.1.0+dev" "git+https://github.com/peregrine-project/cakeml-backend.git#3c47a631d9a6a591e33bcfb72e277844982dd4b0"]
  ["rocq-metarocq-utils.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-common.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-template.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-template-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-safechecker.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-erasure.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-safechecker-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-erasure-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
]

build: [ make "build" ]
install: [ make "install" ]

tags: [
  "keyword:extraction"
  "logpath:Peregrine"
]
