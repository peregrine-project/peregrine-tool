opam-version: "2.0"
name: "rocq-peregrine"
version: "dev"
synopsis: "The Peregrine tool is a unified middle-end for code generation from proof assistants"
description: """
The Peregrine tool is a unified middle-end for code generation from proof assistants
"""
maintainer: "The Peregrine team"
authors: "The Peregrine team"
license: "MIT"
homepage: "https://peregrine-project.github.io/"
dev-repo: "git+https://github.com/peregrine-project/peregrine-tool.git"
bug-reports: "https://github.com/peregrine-project/peregrine-tool/issues"

depends: [
  "rocq-core" {>= "9.1" & < "9.2~"}
  "rocq-stdlib" {>= "9.0" & < "9.2~"}
  "rocq-metarocq-erasure-plugin" {>= "1.5.1" & < "1.5.2"}
  "rocq-typed-extraction-common" {= "0.2.1+dev"}
  "rocq-rust-extraction" {= "0.2.1+dev"}
  "rocq-elm-extraction" {= "0.2.1+dev"}
  "rocq-cakeml-extraction" {= "0.1.1+dev"}
  "rocq-verified-extraction" {= "1.0.0+9.1+dev"}
  "rocq-primitive" {= "9.0.0"}
  "rocq-ceres-bytestring" {= "1.0.0"}
  "rocq-certirocq" {= "dev"}
  "rocq-vellvm" {= "dev"}
  "cmdliner" {>= "2.0.0"}
]

# CertiRocq with the LLVM backend is in no release, and neither are the
# Vellvm commit it needs and the MetaRocq 9.1 snapshot it is built against
# (MetaRocq 1.5.1 lacks EImplementLazyForce).
# The Rust reference-counting mode of rocq-typed-extraction is in no
# release either; its pin gets the version 0.2.1+dev.
# The MetaRocq snapshot gets the version 1.5.1+9.1+dev, so that it satisfies
# the `< 1.5.2` bounds of rocq-verified-extraction and rocq-cakeml-extraction,
# whose releases do not build against it. Keep all commits equal to the ones
# in .github/rocq-peregrine.opam.locked and .nix/.
pin-depends: [
  # The peregrine branch of peregrine-project/certirocq: CertiRocq main
  # (f1e46a48) plus the LLVM backend (vir-llvm-backend, 29f55074) and
  # Peregrine's fixes on top of it.
  ["rocq-certirocq.dev" "git+https://github.com/peregrine-project/certirocq.git#a8dc26feadde902e109ae3a1bbdfacadfc4bb9f6"]
  ["rocq-vellvm.dev" "git+https://github.com/vellvm/vellvm.git#b63a28a0a36cbae73a454d99a97bb8171568343e"]
  # The peregrine branch of peregrine-project/rocq-verified-extraction: its
  # rocq-9.1 branch (02b475a) plus the rename of switch_no_params for
  # MetaRocq#1286, which the 9.1 snapshot needs.
  ["rocq-verified-extraction.1.0.0+9.1+dev" "git+https://github.com/peregrine-project/rocq-verified-extraction.git#0305df76ac89a83488f12175e2c5d45e1a55d16c"]
  # cakeml-backend ported to the MetaRocq 9.1 snapshot, with the datatype
  # declarations and qualified constructor names (cakeml-backend#16).
  ["rocq-cakeml-extraction.0.1.1+dev" "git+https://github.com/peregrine-project/cakeml-backend.git#8df83a16525ca08bb9b5b375b3331b3f480d346b"]
  # The rust-rc-mode branch of peregrine-project/rocq-typed-extraction:
  # 0.2.1 plus the reference-counting memory mode of the Rust printer
  # (memory_mode, RcMode), which the rust-rc verb needs. The three packages
  # require each other at equal versions, so all three are pinned.
  ["rocq-typed-extraction-common.0.2.1+dev" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#6e671a0fc5847581922d5e60ee61e367151c12f1"]
  ["rocq-rust-extraction.0.2.1+dev" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#6e671a0fc5847581922d5e60ee61e367151c12f1"]
  ["rocq-elm-extraction.0.2.1+dev" "git+https://github.com/peregrine-project/rocq-typed-extraction.git#6e671a0fc5847581922d5e60ee61e367151c12f1"]
  ["rocq-metarocq-utils.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-common.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-template.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-template-pcuic.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-safechecker.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-erasure.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-safechecker-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
  ["rocq-metarocq-erasure-plugin.1.5.1+9.1+dev" "git+https://github.com/MetaRocq/metarocq.git#c8cd46054518193103c3bb33aa6e15c7f489e72c"]
]

build: [ make "build" ]
install: [ make "install" ]

tags: [
  "keyword:extraction"
  "logpath:Peregrine"
]
